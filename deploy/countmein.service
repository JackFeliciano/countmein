[Unit]
Description=CountMeIn guest list
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/countmein
Environment=COUNTMEIN_BASE=/countmein/
ExecStart=/usr/bin/php -S 127.0.0.1:8102 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/countmein
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
